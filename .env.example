# 复制为 .env 后按需修改 (docker compose 会自动读取 .env)
# 注意: .env 已被 .gitignore 排除, 不要提交到仓库

# --- MongoDB ---
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_USER=root
# 请改成你自己的密码, 并确保不提交 .env 到仓库
MONGO_PASS=changeme
MONGO_DB=rainbow1

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- 其他 ---
DISPLAY=:99
TZ=Asia/Shanghai

# 可选: 构建 crawler 镜像时传给 camoufox fetch 的 GitHub Token (用于绕过下载限流)
# docker compose build --build-arg GITHUB_TOKEN=xxx crawler
# GITHUB_TOKEN=
